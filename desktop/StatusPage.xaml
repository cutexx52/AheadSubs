<UserControl x:Class="LocalVideoSubtitleTranslator.StatusPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:LocalVideoSubtitleTranslator">
 <UserControl.Resources>
  <Style x:Key="StatusValue" TargetType="TextBlock">
   <Setter Property="FontSize" Value="21"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="Cell" TargetType="TextBlock">
   <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,0,10,0"/>
  </Style>
  <Style x:Key="TableHeader" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
   <Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Foreground" Value="#48566D"/>
  </Style>
 </UserControl.Resources>
 <ScrollViewer Style="{DynamicResource PageScroll}" x:Name="Scroll">
  <StackPanel>
   <DockPanel Margin="0,0,0,12">
    <Button x:Name="RefreshButton" DockPanel.Dock="Right" VerticalAlignment="Top" Margin="12,0,0,0"
     Content="{local:StatusText Refresh}" Click="RefreshClicked"/>
    <StackPanel>
     <TextBlock Text="{local:StatusText Title}" Style="{DynamicResource PageTitle}"/>
     <TextBlock x:Name="Updated" Style="{StaticResource Hint}"/>
    </StackPanel>
   </DockPanel>
   <Border Style="{DynamicResource Card}">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,20,0">
      <TextBlock Text="{local:StatusText Service}" Style="{StaticResource Hint}"/>
      <TextBlock x:Name="ServiceValue" Style="{StaticResource StatusValue}" AutomationProperties.LiveSetting="Polite"/>
      <TextBlock x:Name="ServiceHint" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
     </StackPanel>
     <StackPanel Grid.Column="1">
      <TextBlock x:Name="Connections" Style="{DynamicResource Section}" TextWrapping="Wrap"/>
      <TextBlock x:Name="SourceHint" Style="{StaticResource Hint}"/>
      <ItemsControl x:Name="Sources">
       <ItemsControl.ItemTemplate><DataTemplate>
        <TextBlock Text="{Binding}" Style="{StaticResource Hint}"/>
       </DataTemplate></ItemsControl.ItemTemplate>
      </ItemsControl>
     </StackPanel>
    </Grid>
   </Border>
   <Border Style="{DynamicResource Card}">
    <StackPanel>
     <TextBlock Text="{local:StatusText ModelsAndResources}" Style="{DynamicResource Section}"/>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,20,0">
       <TextBlock x:Name="ModelHint" Style="{StaticResource Hint}"/>
       <ItemsControl x:Name="Models" AutomationProperties.Name="{local:StatusText Models}">
        <ItemsControl.ItemTemplate><DataTemplate>
         <StackPanel Margin="0,0,0,7">
          <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}"/>
         </StackPanel>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
      </StackPanel>
      <StackPanel Grid.Column="1">
       <TextBlock Text="{local:StatusText ResourceScope}" Style="{StaticResource Hint}" Margin="0,0,0,4"/>
       <ItemsControl x:Name="ResourceRows" AutomationProperties.Name="{local:StatusText ResourceScope}">
        <ItemsControl.ItemTemplate><DataTemplate>
         <Grid Margin="0,2,0,2">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock Text="{Binding Title}" Style="{StaticResource Cell}"/>
          <TextBlock Grid.Column="1" Text="{Binding Detail}" FontWeight="SemiBold"/>
         </Grid>
        </DataTemplate></ItemsControl.ItemTemplate>
       </ItemsControl>
      </StackPanel>
     </Grid>
    </StackPanel>
   </Border>
   <Border Style="{DynamicResource Card}">
    <StackPanel>
     <TextBlock Text="{local:StatusText Performance}" Style="{DynamicResource Section}"/>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,10,0">
       <TextBlock Text="{local:StatusText Rtf}" Style="{StaticResource Hint}"/>
       <TextBlock x:Name="Rtf" Style="{StaticResource StatusValue}"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Margin="0,0,10,0">
       <TextBlock Text="P50" Style="{StaticResource Hint}"/><TextBlock x:Name="P50" Style="{StaticResource StatusValue}"/>
      </StackPanel>
      <StackPanel Grid.Column="2" Margin="0,0,10,0">
       <TextBlock Text="P95" Style="{StaticResource Hint}"/><TextBlock x:Name="P95" Style="{StaticResource StatusValue}"/>
      </StackPanel>
      <StackPanel Grid.Column="3">
       <TextBlock Text="P99" Style="{StaticResource Hint}"/><TextBlock x:Name="P99" Style="{StaticResource StatusValue}"/>
      </StackPanel>
     </Grid>
     <TextBlock x:Name="PerformanceSamples" Style="{StaticResource Hint}" Margin="0,7,0,0"/>
     <TextBlock Text="{local:StatusText PerformanceHint}" Style="{StaticResource Hint}" Margin="0,3,0,0"/>
    </StackPanel>
   </Border>
   <Border Style="{DynamicResource Card}">
    <StackPanel>
     <DockPanel>
      <ComboBox DockPanel.Dock="Right" x:Name="Weeks" DisplayMemberPath="Label" SelectedValuePath="Date"
       AutomationProperties.Name="{local:StatusText Week}" Margin="12,0,0,0" SelectionChanged="WeekChanged"/>
      <StackPanel VerticalAlignment="Center">
       <TextBlock Text="{local:StatusText Cloud}" Style="{DynamicResource Section}"/>
       <TextBlock x:Name="CloudSummary" TextWrapping="Wrap" FontWeight="SemiBold"/>
      </StackPanel>
     </DockPanel>
     <TextBlock Text="{local:StatusText CloudHint}" Style="{StaticResource Hint}" Margin="0,9,0,12"/>
     <Grid x:Name="CloudHeader" Margin="0,0,0,6">
      <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Text="{local:StatusText Model}" Style="{StaticResource TableHeader}"/>
      <TextBlock Grid.Column="1" Text="{local:StatusText Calls}" Style="{StaticResource TableHeader}"/>
      <TextBlock Grid.Column="2" Text="{local:StatusText Usage}" Style="{StaticResource TableHeader}"/>
      <TextBlock Grid.Column="3" Text="{local:StatusText Estimate}" Style="{StaticResource TableHeader}"/>
     </Grid>
     <TextBlock x:Name="CloudEmpty" Style="{StaticResource Hint}"/>
     <ItemsControl x:Name="CloudRows" AutomationProperties.Name="{local:StatusText Cloud}">
      <ItemsControl.ItemTemplate><DataTemplate>
       <Border BorderBrush="#E3E7ED" BorderThickness="0,1,0,0" Padding="0,8">
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <StackPanel>
          <TextBlock Text="{Binding Model}" Style="{StaticResource Cell}" FontWeight="SemiBold"/>
          <TextBlock Text="{Binding Provider}" Style="{StaticResource Hint}"/>
         </StackPanel>
         <StackPanel Grid.Column="1">
          <TextBlock Text="{Binding Calls}" Style="{StaticResource Cell}"/>
          <TextBlock Text="{Binding Failures}" Style="{StaticResource Hint}"/>
         </StackPanel>
         <TextBlock Grid.Column="2" Text="{Binding Usage}" Style="{StaticResource Cell}"/>
         <TextBlock Grid.Column="3" Text="{Binding Cost}" TextWrapping="Wrap"/>
        </Grid>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </StackPanel>
   </Border>
  </StackPanel>
 </ScrollViewer>
</UserControl>
