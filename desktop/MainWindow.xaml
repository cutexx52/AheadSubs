<Window x:Class="LocalVideoSubtitleTranslator.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Local Video Subtitle Translator" Width="1040" Height="820" MinWidth="880" MinHeight="650"
 FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14" Background="#F5F6F8" Foreground="#242A35"
 WindowStartupLocation="CenterScreen" Closing="OnClosing" UseLayoutRounding="True">
 <Window.Resources>
  <Style x:Key="PageTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="27"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E3E7ED"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
  <Style x:Key="Section" TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="#596273"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="Margin" Value="10,3"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="NavBorder" Background="Transparent" CornerRadius="7" Padding="18,13"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="#E8EDF9"/><Setter Property="Foreground" Value="#234CA0"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="#EAF0F6"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavBorder" Property="BorderBrush" Value="#547BC1"/><Setter TargetName="NavBorder" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PageScroll" TargetType="ScrollViewer"><Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Setter Property="Padding" Value="32,28,32,16"/><Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="Foreground" Value="#242A35"/><Setter Property="FontWeight" Value="Normal"/></Style>
 </Window.Resources>
 <Grid x:Name="RootLayout" Background="#F5F6F8">
  <Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="White" BorderBrush="#E3E7ED" BorderThickness="0,0,0,1"><Grid Margin="28,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center"><TextBlock Text="视频字幕翻译" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="LOCAL VIDEO SUBTITLE TRANSLATOR" FontFamily="Segoe UI" FontSize="10" Foreground="#6A7484" Margin="0,4,0,0"/></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#EDF3EF" CornerRadius="16" Padding="12,6" VerticalAlignment="Center"><TextBlock x:Name="ServiceStatus" Text="正在连接" FontSize="12" Foreground="#326B4F" AutomationProperties.LiveSetting="Polite"/></Border><Button Content="刷新状态" Click="RefreshStatus" Margin="10,0,0,0" Padding="10,6" MinHeight="30" FontSize="12"/></StackPanel>
  </Grid></Border>
  <TabControl x:Name="SettingsPanel" Grid.Row="1" TabStripPlacement="Left" BorderThickness="0" Background="#F5F6F8" SelectionChanged="PageChanged">
   <TabControl.Template><ControlTemplate TargetType="TabControl"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="176"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#F0F2F5" BorderBrush="#E3E7ED" BorderThickness="0,0,1,0"><StackPanel Margin="0,22,0,0"><TabPanel IsItemsHost="True"/></StackPanel></Border><ContentPresenter Grid.Column="1" ContentSource="SelectedContent"/></Grid></ControlTemplate></TabControl.Template>
   <TabItem Header="翻译" x:Name="TranslationTab"><ScrollViewer Style="{StaticResource PageScroll}"><StackPanel>
    <TextBlock Text="翻译设置" Style="{StaticResource PageTitle}"/><TextBlock Text="PotPlayer：Ctrl+Alt+J 开启，Ctrl+Alt+K 关闭当前窗口翻译。" Style="{StaticResource Hint}" Margin="0,0,0,16"/>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="语言与显示" Style="{StaticResource Section}"/>
     <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="视频语言" Margin="0,0,0,8" Foreground="#596273"/><ComboBox x:Name="SourceLanguage" DisplayMemberPath="Label" SelectedValuePath="Value" AutomationProperties.Name="视频语言"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="翻译为" Margin="0,0,0,8" Foreground="#596273"/><ComboBox x:Name="TargetLanguage" DisplayMemberPath="Label" SelectedValuePath="Value" AutomationProperties.Name="目标字幕语言"/></StackPanel></Grid>
     <CheckBox x:Name="Bilingual" Content="双语字幕 · 同时显示原文和译文" Margin="0,20,0,0"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="使用的模型" Style="{StaticResource Section}"/><TextBlock Text="语音识别" Margin="0,10,0,8" Foreground="#596273"/><ComboBox x:Name="SpeechModel" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="SelectionChanged" AutomationProperties.Name="语音识别模型"/><TextBlock Text="字幕翻译" Margin="0,18,0,8" Foreground="#596273"/><ComboBox x:Name="TranslationModel" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="SelectionChanged" AutomationProperties.Name="字幕翻译模型"/>
     <DockPanel Margin="0,12,0,0"><Button x:Name="CloudKeysButton" Content="设置密钥" Click="GoKeys" DockPanel.Dock="Right" FontSize="12" Padding="10,5" MinHeight="28" Margin="12,0,0,0"/><TextBlock x:Name="TranslationHint" Style="{StaticResource Hint}" VerticalAlignment="Center"/></DockPanel>
    </StackPanel></Border>
    <Border x:Name="FirstRunPanel" Background="#E8EDF9" CornerRadius="8" Padding="18" Margin="0,0,0,16" Visibility="Collapsed"><DockPanel><Button Content="准备本地模型" Click="GoModels" DockPanel.Dock="Right" Margin="16,0,0,0"/><StackPanel><TextBlock Text="还没有可用的本地模型" FontWeight="SemiBold"/><TextBlock Text="一次下载，之后本地运行无需 API 费用。" Style="{StaticResource Hint}" Margin="0,5,0,0"/></StackPanel></DockPanel></Border>
    <TextBlock x:Name="ServiceDetail" Text="正在读取服务状态。" Style="{StaticResource Hint}"/><TextBlock x:Name="SessionStatus" Style="{StaticResource Hint}" Margin="0,6,0,0" Visibility="Collapsed"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="字幕检查" x:Name="InspectTab"><Grid Margin="32,28,32,24" TextElement.Foreground="#242A35" TextElement.FontWeight="Normal"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock Text="查看原文与译文" Style="{StaticResource PageTitle}"/><TextBlock Text="先检查识别结果，再判断翻译质量。这里显示已经生成的字幕。" Style="{StaticResource Hint}" Margin="0,0,0,24"/></StackPanel>
    <DockPanel Grid.Row="1" Margin="0,0,0,18"><Button x:Name="InspectRefreshButton" Content="刷新字幕" Click="RefreshSubtitles" DockPanel.Dock="Right" Margin="12,0,0,0"/><ComboBox x:Name="MediaChoice" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="InspectMediaChanged" AutomationProperties.Name="检查的视频"/></DockPanel>
    <DataGrid x:Name="SubtitleRows" Grid.Row="2" SizeChanged="SubtitleSizeChanged" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderBrush="#E0E5EC" BorderThickness="1" Background="White" RowBackground="White" AlternatingRowBackground="#FAFBFD" HorizontalGridLinesBrush="#E9EDF2" RowHeaderWidth="0" SelectionMode="Single" EnableRowVirtualization="True">
     <DataGrid.Resources><Style TargetType="DataGridCell"><Setter Property="Padding" Value="12,10"/><Setter Property="BorderThickness" Value="0"/></Style><Style TargetType="DataGridColumnHeader"><Setter Property="Padding" Value="12"/><Setter Property="Background" Value="#EEF1F6"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0"/></Style></DataGrid.Resources>
     <DataGrid.Columns><DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="100" MinWidth="100"/><DataGridTextColumn Header="识别原文" Binding="{Binding Original}" Width="*" MinWidth="180"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="12,10"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn Header="翻译字幕" Binding="{Binding Translation}" Width="*" MinWidth="180"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="12,10"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns>
    </DataGrid><TextBlock x:Name="InspectStatus" Grid.Row="3" Text="点击刷新，读取最近的视频字幕。" Style="{StaticResource Hint}" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
   </Grid></TabItem>
   <TabItem Header="播放器" x:Name="PlayersTab"><ScrollViewer Style="{StaticResource PageScroll}"><StackPanel>
    <TextBlock Text="连接你的播放器" Style="{StaticResource PageTitle}"/><TextBlock Text="各个播放窗口独立控制，共用同一套模型。" Style="{StaticResource Hint}" Margin="0,0,0,24"/>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="PotPlayer" Style="{StaticResource Section}"/><TextBlock Text="正常打开视频后，在当前播放窗口使用快捷键。" Style="{StaticResource Hint}"/>
     <Grid Margin="0,20,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="开启翻译" Foreground="#596273"/><TextBlock Text="Ctrl + Alt + J" FontFamily="Segoe UI" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="关闭翻译" Foreground="#596273"/><TextBlock Text="Ctrl + Alt + K" FontFamily="Segoe UI" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0"/></StackPanel></Grid>
     <Button Content="安装 PotPlayer 菜单" Click="InstallPotPlayer" HorizontalAlignment="Left"/><TextBlock x:Name="PlayerDetection" Style="{StaticResource Hint}" Margin="0,12,0,0"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="mpv" Style="{StaticResource Section}"/><TextBlock Text="安装播放器脚本，通过菜单开启或关闭当前窗口的字幕翻译。" Style="{StaticResource Hint}" Margin="0,0,0,16"/><Button Content="安装 mpv 菜单" Click="InstallMpv" HorizontalAlignment="Left"/></StackPanel></Border>
    <TextBlock Text="首次无法读取完整文件路径时，可能需要选择一次当前视频。同目录内的后续视频会自动匹配。" Style="{StaticResource Hint}"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="本地模型" x:Name="ModelsTab"><ScrollViewer Style="{StaticResource PageScroll}"><StackPanel>
    <TextBlock Text="模型留在你的电脑上" Style="{StaticResource PageTitle}"/><TextBlock Text="只需下载一次。安装完成的模型会出现在翻译页。" Style="{StaticResource Hint}" Margin="0,0,0,24"/>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="从一套完整方案开始" Style="{StaticResource Section}"/><TextBlock Text="Qwen3-ASR 0.6B 识别 + NLLB 本地翻译" Margin="0,6,0,8"/><TextBlock Text="识别需要支持 Vulkan 的显卡；翻译先使用 CPU。启动后可在高级设置中调整。" Style="{StaticResource Hint}"/><Button Content="安装并启用本地方案" Click="SetupLocal" HorizontalAlignment="Left" Margin="0,18,0,0"/>
     <Separator Margin="0,22"/><TextBlock Text="没有合适的显卡？" FontWeight="SemiBold"/><TextBlock Text="可使用 Whisper Small + NLLB 的 CPU 方案。运行速度取决于处理器，可能无法跟上播放。" Style="{StaticResource Hint}" Margin="0,8,0,16"/><Button Content="安装并启用 CPU 方案" Click="SetupCpu" HorizontalAlignment="Left"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="单独安装模型" Style="{StaticResource Section}"/><DockPanel Margin="0,10,0,0"><Button Content="安装模型" DockPanel.Dock="Right" Margin="12,0,0,0" Click="InstallModel"/><ComboBox x:Name="InstallChoice" DisplayMemberPath="Label" SelectedValuePath="Value" AutomationProperties.Name="要安装的模型"/></DockPanel><TextBlock x:Name="ModelSummary" Style="{StaticResource Hint}" Margin="0,14,0,0"/></StackPanel></Border>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="密钥" x:Name="KeysTab"><ScrollViewer Style="{StaticResource PageScroll}"><StackPanel>
    <TextBlock Text="连接你的云端账户" Style="{StaticResource PageTitle}"/><TextBlock Text="服务商直接向你的账户计费。本地模型不需要 API 密钥。" Style="{StaticResource Hint}" Margin="0,0,0,24"/>
    <Border Style="{StaticResource Card}" x:Name="QwenMtPanel"><StackPanel><TextBlock Text="阿里云百炼" Style="{StaticResource Section}"/><TextBlock Text="用于 Qwen-MT 翻译。选择包含百炼 API Key 的文件。" Style="{StaticResource Hint}" Margin="0,0,0,16"/><DockPanel><Button Content="选择文件" DockPanel.Dock="Right" Margin="12,0,0,0" Click="BrowseQwen"/><TextBox x:Name="QwenKey" AutomationProperties.Name="百炼密钥文件路径"/></DockPanel><TextBlock Text="需要百炼 API Key，不是 AccessKey / AccessSecret。" Style="{StaticResource Hint}" Margin="0,10,0,0"/><TextBlock Text="服务地址（留空使用默认区域）" Style="{StaticResource Label}"/><TextBox x:Name="QwenUrl" AutomationProperties.Name="百炼服务地址"/></StackPanel></Border>
    <Border Style="{StaticResource Card}" x:Name="OpenAiPanel"><StackPanel><TextBlock Text="OpenAI / 自定义 API" Style="{StaticResource Section}"/><TextBlock Text="用于 OpenAI 识别、翻译，或使用同类接口的自定义服务。" Style="{StaticResource Hint}" Margin="0,0,0,16"/><DockPanel><Button Content="选择文件" DockPanel.Dock="Right" Margin="12,0,0,0" Click="BrowseOpenAi"/><TextBox x:Name="OpenAiKey" AutomationProperties.Name="OpenAI 密钥文件路径"/></DockPanel></StackPanel></Border>
    <TextBlock Text="软件只保存文件位置，不在界面显示密钥内容。使用本地识别与云端翻译时，仅识别出的文字发送到翻译服务。" Style="{StaticResource Hint}"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="高级设置" x:Name="AdvancedTab"><ScrollViewer Style="{StaticResource PageScroll}"><StackPanel>
    <TextBlock Text="按需调整细节" Style="{StaticResource PageTitle}"/><TextBlock Text="默认值适合入门。音频分段和翻译上下文是不同的设置。" Style="{StaticResource Hint}" Margin="0,0,0,24"/>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="翻译上下文" Style="{StaticResource Section}"/><TextBlock Text="让翻译模型参考邻近原文，仍然只输出当前句的译文。均为 0 时关闭。" Style="{StaticResource Hint}"/>
     <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="前文范围（0–15 秒）" Margin="0,0,0,8"/><TextBox x:Name="TranslationBefore" AutomationProperties.Name="翻译前文范围秒数"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="后文范围（0–15 秒）" Margin="0,0,0,8"/><TextBox x:Name="TranslationAfter" AutomationProperties.Name="翻译后文范围秒数"/></StackPanel></Grid>
     <TextBlock Text="翻译风格或补充要求" Style="{StaticResource Label}"/><TextBox x:Name="TranslationPrompt" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="88" MaxHeight="160" MaxLength="1000" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="翻译补充要求"/><TextBlock x:Name="TranslationCapabilityHint" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="本地运算" Style="{StaticResource Section}"/><TextBlock Text="Whisper / NLLB 运算设备" Margin="0,8,0,8"/><ComboBox x:Name="Device" DisplayMemberPath="Label" SelectedValuePath="Value" AutomationProperties.Name="本地运算设备"/><TextBlock Text="Qwen3-ASR 使用独立的 Vulkan 运行时，不受此选项影响。" Style="{StaticResource Hint}" Margin="0,10,0,0"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="语音检测（VAD）" Style="{StaticResource Section}"/><TextBlock Text="先判断哪里有人说话，再把这些音频交给识别模型。" Style="{StaticResource Hint}"/><ComboBox x:Name="Vad" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="VadChanged" AutomationProperties.Name="语音活动检测模型" Margin="0,16,0,0"/>
     <TextBlock Text="语音门槛（0–1）" Style="{StaticResource Label}"/><TextBox x:Name="VadThreshold" AutomationProperties.Name="语音检测门槛"/><TextBlock Text="越高越严格，可能漏掉轻声。" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
     <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="最短片段（秒）" Margin="0,0,0,8"/><TextBox x:Name="MinSpeech" AutomationProperties.Name="最短语音片段秒数"/><TextBlock Text="优先避免过碎的短段，仍会考虑实际停顿。" Style="{StaticResource Hint}" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="单段最长（2–20 秒）" Margin="0,0,0,8"/><TextBox x:Name="MaxSpeech" AutomationProperties.Name="最长语音段秒数"/><TextBlock Text="连续讲话过长时分段，限制单次识别。" Style="{StaticResource Hint}" Margin="0,6,0,0"/></StackPanel></Grid>
     <TextBlock Text="Silero 默认 0.50，FSMN 默认 0.80；不同模型的数值不可直接比较。" Style="{StaticResource Hint}" Margin="0,12,0,0"/>
     <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="断句停顿（毫秒）" Margin="0,0,0,8"/><TextBox x:Name="MinSilence" AutomationProperties.Name="断句停顿毫秒数"/><TextBlock Text="越长越不容易把短暂停顿切开。" Style="{StaticResource Hint}" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="句边留白（毫秒）" Margin="0,0,0,8"/><TextBox x:Name="PaddingMs" AutomationProperties.Name="句边留白毫秒数"/><TextBlock Text="保留句子两端的音频，减少截断。" Style="{StaticResource Hint}" Margin="0,6,0,0"/></StackPanel></Grid>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="预读与跳转" Style="{StaticResource Section}"/><TextBlock Text="决定从视频的什么位置取音频，不等同于翻译模型的文字上下文。" Style="{StaticResource Hint}"/>
     <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="缓存任务块（4–20 秒）" Margin="0,0,0,8"/><TextBox x:Name="ChunkSeconds" AutomationProperties.Name="缓存任务块秒数"/><TextBlock Text="只控制后台任务调度，不规定字幕句长。" Style="{StaticResource Hint}" Margin="0,6,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="跳转最少回补（0–30 秒）" Margin="0,0,0,8"/><TextBox x:Name="Backfill" AutomationProperties.Name="跳转最少回补秒数"/><TextBlock Text="补找跳转前的句首；长句时会自动增加。" Style="{StaticResource Hint}" Margin="0,6,0,0"/></StackPanel></Grid>
     <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="向前额外找停顿（0–5 秒）" Margin="0,0,0,8"/><TextBox x:Name="BeforeSeconds" AutomationProperties.Name="向前额外找停顿秒数"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="向后额外找停顿（0–5 秒）" Margin="0,0,0,8"/><TextBox x:Name="AfterSeconds" AutomationProperties.Name="向后额外找停顿秒数"/></StackPanel></Grid><TextBlock Text="在候选音频范围之外额外搜索停顿，优先沿自然边界切分。" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="自定义 API" Style="{StaticResource Section}"/><TextBlock Text="连接使用同类 API 格式的本地或云端服务。" Style="{StaticResource Hint}"/><TextBlock Text="识别服务地址 / 模型名称" Style="{StaticResource Label}"/><TextBox x:Name="AsrUrl" AutomationProperties.Name="自定义识别 API 地址"/><TextBox x:Name="AsrModel" AutomationProperties.Name="自定义识别模型名称" Margin="0,8,0,12"/><Button Content="选用此识别服务" HorizontalAlignment="Left" Click="ChooseCustomSpeech"/><TextBlock Text="翻译服务地址 / 模型名称" Style="{StaticResource Label}"/><TextBox x:Name="LlmUrl" AutomationProperties.Name="自定义翻译 API 地址"/><TextBox x:Name="LlmModel" AutomationProperties.Name="自定义翻译模型名称" Margin="0,8,0,12"/><Button Content="选用此翻译服务" HorizontalAlignment="Left" Click="ChooseCustomTranslation"/></StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="诊断" Style="{StaticResource Section}"/><CheckBox x:Name="Diagnostics" Content="记录详细诊断日志" Margin="0,8,0,10"/><TextBlock Text="仅排查问题时开启。关闭诊断不会隐藏必要的错误提示。" Style="{StaticResource Hint}"/><Button Content="打开日志目录" Click="OpenLogs" HorizontalAlignment="Left" Margin="0,18,0,0"/></StackPanel></Border>
   </StackPanel></ScrollViewer></TabItem>
  </TabControl>
  <Border Grid.Row="2" Background="White" BorderBrush="#E3E7ED" BorderThickness="0,1,0,0" Padding="28,14"><StackPanel>
   <TextBlock x:Name="ActionStatus" TextWrapping="Wrap" Margin="176,0,0,8" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive"/><ProgressBar x:Name="Progress" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="176,0,0,10"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="176"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="ExitButton" Content="退出" Click="Exit" HorizontalAlignment="Left"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="ApplyButton" Content="保存并启动" Click="Apply" Background="#2E59AE" Foreground="White" BorderBrush="#2E59AE" FontWeight="SemiBold"/><Button x:Name="StopButton" Content="停止服务" Click="Stop"/></StackPanel><TextBlock Grid.Column="2" Text="关闭窗口后留在托盘" Style="{StaticResource Hint}" VerticalAlignment="Center"/></Grid>
  </StackPanel></Border>
 </Grid>
</Window>
