<Window x:Class="AheadSubs.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AheadSubs"
 Title="AheadSubs" Icon="/Assets/AheadSubs.ico" Width="1040" Height="820" MinWidth="880" MinHeight="650"
 FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14" Background="#F5F6F8" Foreground="#242A35"
 WindowStartupLocation="CenterScreen" Closing="OnClosing" UseLayoutRounding="True">
 <Window.Resources>
  <Style x:Key="PageTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="27"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E3E7ED"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
  <Style x:Key="Section" TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <Style x:Key="SettingsExpander" TargetType="Expander">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander">
    <Border Background="White" BorderBrush="#E3E7ED" BorderThickness="1" CornerRadius="6">
     <StackPanel>
      <ToggleButton Content="{TemplateBinding Header}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
       <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
        <Border x:Name="HeaderFrame" CornerRadius="5" Padding="12,7" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
         <DockPanel><Path x:Name="Chevron" Data="M 0,0 L 4,4 L 8,0" Stroke="#526076" StrokeThickness="1.25" VerticalAlignment="Center" DockPanel.Dock="Right" Margin="8,0,0,0"/><ContentPresenter VerticalAlignment="Center"/></DockPanel>
        </Border>
        <ControlTemplate.Triggers>
         <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderFrame" Property="Background" Value="#F2F5FB"/></Trigger>
         <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HeaderFrame" Property="BorderBrush" Value="#5280D4"/></Trigger>
         <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Data" Value="M 0,4 L 4,0 L 8,4"/></Trigger>
        </ControlTemplate.Triggers>
       </ControlTemplate></ToggleButton.Template>
      </ToggleButton>
      <ContentPresenter x:Name="ExpanderBody" Visibility="Collapsed"/>
     </StackPanel>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpanderBody" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="#596273"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="Margin" Value="10,3"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="NavBorder" Background="Transparent" CornerRadius="7" Padding="12,9"><TextBlock Text="{TemplateBinding Header}" TextWrapping="Wrap"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="#E8EDF9"/><Setter Property="Foreground" Value="#234CA0"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="#EAF0F6"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="NavBorder" Property="BorderBrush" Value="#547BC1"/><Setter TargetName="NavBorder" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PageScroll" TargetType="ScrollViewer"><Setter Property="VerticalScrollBarVisibility" Value="Auto"/><Setter Property="Padding" Value="32,28,32,16"/><Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/><Setter Property="Foreground" Value="#242A35"/><Setter Property="FontWeight" Value="Normal"/></Style>
 </Window.Resources>
 <Grid x:Name="RootLayout" Background="#F5F6F8">
  <Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="White" BorderBrush="#E3E7ED" BorderThickness="0,0,0,1"><Grid Margin="28,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="/Assets/AheadSubs.png" Width="44" Height="44" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/><StackPanel VerticalAlignment="Center"><TextBlock Text="AheadSubs" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource Desktop.Tagline}" FontSize="11" Foreground="#6A7484" Margin="0,4,0,0"/></StackPanel></StackPanel>
   <StackPanel x:Name="ServiceStrip" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#EDF3EF" CornerRadius="16" Padding="12,6" VerticalAlignment="Center"><TextBlock x:Name="ServiceStatus" Text="{DynamicResource Desktop.Connecting}" FontSize="12" Foreground="#326B4F" AutomationProperties.LiveSetting="Polite"/></Border><Button Content="{DynamicResource Desktop.RefreshStatus}" Click="RefreshStatus" Margin="10,0,0,0" Padding="10,6" MinHeight="30" FontSize="12"/></StackPanel>
  </Grid></Border>
  <TabControl x:Name="SettingsPanel" Grid.Row="1" TabStripPlacement="Left" BorderThickness="0" Background="#F5F6F8" SelectionChanged="PageChanged">
   <TabControl.Template><ControlTemplate TargetType="TabControl"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="192"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#F0F2F5" BorderBrush="#E3E7ED" BorderThickness="0,0,1,0"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,22,0,0" IsItemsHost="True"/></ScrollViewer></Border><ContentPresenter Grid.Column="1" ContentSource="SelectedContent"/></Grid></ControlTemplate></TabControl.Template>
   <TabItem Header="{DynamicResource Automation.SubtitleTab}" x:Name="TranslationTab"><ScrollViewer x:Name="TranslationScroll" Style="{StaticResource PageScroll}"><StackPanel>
    <TextBlock x:Name="TranslationTitle" Text="{DynamicResource Automation.SubtitleSettings}" Style="{StaticResource PageTitle}"/>
    <Expander x:Name="PresetDisclosure" Margin="0,0,0,12" Style="{StaticResource SettingsExpander}" Expanded="PresetOpened">
     <StackPanel Margin="10,8,10,4">
      <ComboBox x:Name="PresetChoice" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="PresetChanged"/>
      <TextBlock x:Name="PresetDetail" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
      <TextBlock x:Name="PresetStatus" Style="{StaticResource Hint}" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite"/>
      <WrapPanel Margin="0,6,0,0">
       <Button x:Name="PresetDownload" Click="DownloadPreset" MinHeight="28" Padding="9,4" Visibility="Collapsed"/>
       <Button x:Name="PresetModels" Click="GoPresetModels" MinHeight="28" Padding="9,4" Visibility="Collapsed"/>
       <Button x:Name="PresetKeys" Click="GoPresetKeys" MinHeight="28" Padding="9,4" Visibility="Collapsed"/>
       <Button x:Name="PresetRetry" Click="PresetOpened" MinHeight="28" Padding="9,4" Visibility="Collapsed"/>
       <Button x:Name="PresetApply" Click="ApplyPreset" MinHeight="28" Padding="9,4" Visibility="Collapsed"/>
      </WrapPanel>
     </StackPanel>
    </Expander>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource Desktop.LanguageDisplay}" Style="{StaticResource Section}"/>
     <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{DynamicResource Desktop.VideoLanguage}" Margin="0,0,0,8" Foreground="#596273"/><ComboBox x:Name="SourceLanguage" DisplayMemberPath="Label" SelectedValuePath="Value" AutomationProperties.Name="{DynamicResource Desktop.VideoLanguage}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource Desktop.TranslateTo}" Margin="0,0,0,8" Foreground="#596273"/><ComboBox x:Name="TargetLanguage" DisplayMemberPath="Label" SelectedValuePath="Value" AutomationProperties.Name="{DynamicResource Desktop.TargetLanguage}"/></StackPanel></Grid>
     <CheckBox x:Name="Bilingual" Content="{DynamicResource Desktop.Bilingual}" Margin="0,20,0,0"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{DynamicResource Desktop.Models}" Style="{StaticResource Section}"/><TextBlock Text="{DynamicResource Desktop.Speech}" Margin="0,10,0,8" Foreground="#596273"/><ComboBox x:Name="SpeechModel" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="SelectionChanged" AutomationProperties.Name="{DynamicResource Desktop.SpeechModel}"/><TextBlock x:Name="SpeechCost" Style="{StaticResource Hint}" Margin="0,6,0,0"/><TextBlock Text="{DynamicResource Desktop.Translation}" Margin="0,18,0,8" Foreground="#596273"/><ComboBox x:Name="TranslationModel" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="SelectionChanged" AutomationProperties.Name="{DynamicResource Desktop.TranslationModel}"/><TextBlock x:Name="TranslationCost" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
     <DockPanel Margin="0,12,0,0"><Button x:Name="CloudKeysButton" Content="{DynamicResource Desktop.CloudSettings}" Click="GoKeys" DockPanel.Dock="Right" FontSize="12" Padding="10,5" MinHeight="28" Margin="12,0,0,0"/><TextBlock x:Name="TranslationHint" Style="{StaticResource Hint}" VerticalAlignment="Center"/></DockPanel>
     <Expander x:Name="TranslationEnhancement" Header="{DynamicResource Desktop.Context}" Margin="0,14,0,0" Visibility="Collapsed">
      <StackPanel Margin="0,10,0,0">
       <CheckBox x:Name="EnhancementEnabled" Content="{DynamicResource Desktop.EnableContext}"/>
       <TextBlock x:Name="TranslationCapabilityHint" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
       <StackPanel IsEnabled="{Binding IsChecked, ElementName=EnhancementEnabled}">
        <Grid x:Name="PreviousCuesPanel"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="{DynamicResource Desktop.PreviousCues}" Style="{StaticResource Label}"/><TextBox x:Name="PreviousCues" Width="100" HorizontalAlignment="Left" MaxLength="1" AutomationProperties.Name="{DynamicResource Desktop.MaxCues}"/></StackPanel>
         <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource Desktop.Characters}" Style="{StaticResource Label}"/><TextBox x:Name="ContextChars" Width="100" HorizontalAlignment="Left" MaxLength="4" AutomationProperties.Name="{DynamicResource Desktop.MaxCharacters}"/></StackPanel>
        </Grid>
        <TextBlock Text="{DynamicResource Desktop.Prompt}" Style="{StaticResource Label}"/><TextBox x:Name="TranslationPrompt" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" MaxHeight="144" MaxLength="1000" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{DynamicResource Desktop.Prompt}"/>
       </StackPanel>
      </StackPanel>
     </Expander>
     <TextBlock x:Name="ComputeSummary" Style="{StaticResource Hint}" Margin="0,12,0,0" Visibility="Collapsed"/>
    </StackPanel></Border>
    <TextBlock x:Name="ServiceDetail" Text="{DynamicResource Desktop.ReadingStatus}" Style="{StaticResource Hint}"/><TextBlock x:Name="SessionStatus" Style="{StaticResource Hint}" Margin="0,6,0,0" Visibility="Collapsed"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem x:Name="InspectTab">
    <Grid Margin="28,24,28,20" TextElement.Foreground="#242A35" TextElement.FontWeight="Normal">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="0,0,0,14">
      <Button x:Name="InspectRefreshButton" DockPanel.Dock="Right" Click="RefreshSubtitles" VerticalAlignment="Center"/>
      <TextBlock x:Name="InspectTitle" Style="{StaticResource PageTitle}" Margin="0"/>
     </DockPanel>
     <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="29*" MinWidth="180" MaxWidth="270"/><ColumnDefinition Width="16"/><ColumnDefinition Width="71*"/></Grid.ColumnDefinitions>
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <Label x:Name="InspectSearchLabel" Target="{Binding ElementName=MediaSearch}" Padding="0,0,0,4"/>
       <TextBox x:Name="MediaSearch" Grid.Row="1" TextChanged="InspectFilterChanged" Margin="0,0,0,7" MinHeight="28"/>
       <ComboBox x:Name="SourceFilter" Grid.Row="2" DisplayMemberPath="Label" SelectedValuePath="Value"
                 SelectionChanged="InspectFilterChanged" Margin="0,0,0,10"/>
       <ListBox x:Name="MediaList" Grid.Row="3" SelectedValuePath="Id" SelectionChanged="InspectMediaChanged"
                Background="White" BorderBrush="#E0E5EC" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
        <ListBox.ItemContainerStyle>
         <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
         <DataTemplate>
          <StackPanel Margin="6,5" ToolTip="{Binding Path}">
           <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
           <TextBlock Text="{Binding Location}" FontSize="12" Foreground="#526076" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
         </DataTemplate>
        </ListBox.ItemTemplate>
       </ListBox>
      </Grid>
      <Grid x:Name="InspectDetails" Grid.Column="2" Visibility="Collapsed">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <StackPanel>
        <TextBlock x:Name="InspectFileName" Style="{StaticResource Section}" Margin="0,0,0,3" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="InspectPath" Style="{StaticResource Hint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,0,0,9"/>
        <DockPanel>
         <Label x:Name="InspectVersionLabel" Target="{Binding ElementName=VersionChoice}" Padding="0,4,8,4" VerticalAlignment="Center"/>
         <ComboBox x:Name="VersionChoice" DisplayMemberPath="Label" SelectedValuePath="Value"
                   SelectionChanged="InspectVersionChanged"/>
        </DockPanel>
        <WrapPanel Margin="0,9,0,0">
         <TextBlock x:Name="InspectSource" Margin="0,0,18,4"/>
         <TextBlock x:Name="InspectCoverage" Margin="0,0,0,4"/>
        </WrapPanel>
        <TextBlock x:Name="InspectTargets" Style="{StaticResource Hint}" Margin="0,0,0,3"/>
        <TextBlock x:Name="InspectGenerationState" Style="{StaticResource Hint}" AutomationProperties.LiveSetting="Polite"/>
       </StackPanel>
       <WrapPanel Grid.Row="1" Margin="0,9,0,8">
        <Button x:Name="InspectRegenerate" Click="RegenerateSubtitle" Margin="0,0,7,3"/>
        <Button x:Name="InspectOpen" Click="OpenSubtitle" Margin="0,0,7,3"/>
        <Button x:Name="InspectSave" Click="SaveSubtitle" Margin="0,0,0,3"/>
       </WrapPanel>
       <TextBlock x:Name="InspectPreviewNote" Grid.Row="2" Style="{StaticResource Hint}" Margin="0,0,0,5"/>
       <DataGrid x:Name="SubtitleRows" Grid.Row="3" SizeChanged="SubtitleTableResized" HorizontalScrollBarVisibility="Disabled" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderBrush="#E0E5EC" BorderThickness="1" Background="White" RowBackground="White" AlternatingRowBackground="#FAFBFD" HorizontalGridLinesBrush="#E9EDF2" RowHeaderWidth="0" SelectionMode="Single" EnableRowVirtualization="True">
     <DataGrid.Resources><Style TargetType="DataGridCell"><Setter Property="Padding" Value="12,10"/><Setter Property="BorderThickness" Value="0"/></Style><Style TargetType="DataGridColumnHeader"><Setter Property="Padding" Value="12"/><Setter Property="Background" Value="#EEF1F6"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="BorderThickness" Value="0"/></Style></DataGrid.Resources>
     <DataGrid.Columns><DataGridTextColumn x:Name="InspectTimeColumn" Binding="{Binding Time}" Width="94"/><DataGridTextColumn x:Name="InspectOriginalColumn" Binding="{Binding Original}" Width="*" MinWidth="112"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="12,10"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn><DataGridTextColumn x:Name="InspectTranslationColumn" Binding="{Binding Translation}" Width="*" MinWidth="112"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="12,10"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn></DataGrid.Columns>
    </DataGrid>
      </Grid>
     </Grid>
     <TextBlock x:Name="InspectStatus" Grid.Row="2" Style="{StaticResource Hint}" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/>
    </Grid>
   </TabItem>
   <TabItem Header="{DynamicResource Desktop.Players}" x:Name="PlayersTab"><ScrollViewer Style="{StaticResource PageScroll}"><StackPanel>
    <TextBlock Text="{DynamicResource Desktop.Players}" Style="{StaticResource PageTitle}"/>
    <Border Style="{StaticResource Card}"><StackPanel>
     <DockPanel><TextBlock x:Name="PlayerDetection" Style="{StaticResource Hint}" DockPanel.Dock="Right"/><TextBlock Text="PotPlayer" Style="{StaticResource Section}"/></DockPanel>
     <WrapPanel Margin="0,6,0,14"><Button x:Name="ConfigurePotPlayer" Content="{DynamicResource Desktop.Configure}" Tag="potplayer" Click="ConfigurePlayer"/><Button x:Name="RemovePotPlayer" Content="{DynamicResource Desktop.Remove}" Tag="potplayer" Click="RemovePlayer" Visibility="Collapsed"/><Button x:Name="PickPotPlayer" Content="{DynamicResource Desktop.ChooseLocation}" Tag="potplayer" Click="PickPlayerFolder"/></WrapPanel>
     <TextBlock x:Name="PotPlayerFolder" Style="{StaticResource Hint}" Margin="0,0,0,8"/>
     <TextBlock Text="{DynamicResource Desktop.TrayHint}" Style="{StaticResource Hint}"/>
     <TextBlock Text="{DynamicResource Desktop.PotHint}" Style="{StaticResource Hint}"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel>
     <DockPanel><TextBlock x:Name="MpvIntegration" Style="{StaticResource Hint}" DockPanel.Dock="Right"/><TextBlock Text="mpv" Style="{StaticResource Section}"/></DockPanel>
     <WrapPanel Margin="0,6,0,14"><Button x:Name="ConfigureMpv" Content="{DynamicResource Desktop.Configure}" Tag="mpv" Click="ConfigurePlayer"/><Button x:Name="RemoveMpv" Content="{DynamicResource Desktop.Remove}" Tag="mpv" Click="RemovePlayer" Visibility="Collapsed"/><Button x:Name="PickMpv" Content="{DynamicResource Desktop.ChooseLocation}" Tag="mpv" Click="PickPlayerFolder"/></WrapPanel>
     <TextBlock x:Name="MpvFolder" Style="{StaticResource Hint}" Margin="0,0,0,8"/>
     <TextBlock Text="{DynamicResource Desktop.MpvHint}" Style="{StaticResource Hint}"/>
    </StackPanel></Border>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="{DynamicResource Desktop.LocalModels}" x:Name="ModelsTab"><ScrollViewer Style="{StaticResource PageScroll}"><StackPanel>
    <StackPanel.Resources>
     <DataTemplate x:Key="ModelRow">
      <Border Padding="0,8" BorderBrush="#E3E7ED" BorderThickness="0,0,0,1">
       <DockPanel>
        <Button Content="{Binding Action}" IsEnabled="{Binding CanAct}" ToolTip="{Binding DisabledReason}" ToolTipService.ShowOnDisabled="True" Tag="{Binding}" Click="ManageModel" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center" MinWidth="78"/>
        <StackPanel>
         <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
         <TextBlock Text="{Binding Details}" Style="{StaticResource Hint}" Margin="0,3,0,0"/>
         <TextBlock Text="{Binding Status}"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Hint}"><Style.Triggers><DataTrigger Binding="{Binding Status}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
        </StackPanel>
       </DockPanel>
      </Border>
     </DataTemplate>
    </StackPanel.Resources>
    <TextBlock x:Name="ModelsHeading" Style="{StaticResource PageTitle}"/>
    <Border Style="{StaticResource Card}"><StackPanel>
     <TextBlock x:Name="AsrModelHeading" Style="{StaticResource Section}"/>
     <ItemsControl x:Name="SpeechDownloads" ItemTemplate="{StaticResource ModelRow}"/>
     <TextBlock x:Name="SharedModelsHint" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
     <TextBlock x:Name="WhisperDeviceLabel" Style="{StaticResource Label}"/>
     <ComboBox x:Name="WhisperDevice" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="DeviceChanged"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel>
     <TextBlock x:Name="MtModelHeading" Style="{StaticResource Section}"/>
     <ItemsControl x:Name="TranslationDownloads" ItemTemplate="{StaticResource ModelRow}"/>
     <TextBlock x:Name="NllbDeviceLabel" Style="{StaticResource Label}"/>
     <ComboBox x:Name="NllbDevice" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="DeviceChanged"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}"><StackPanel>
     <TextBlock x:Name="VadModelHeading" Style="{StaticResource Section}"/>
     <TextBlock x:Name="VadModelHint" Style="{StaticResource Hint}"/>
    </StackPanel></Border>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="{DynamicResource Desktop.CloudModels}" x:Name="KeysTab"><ScrollViewer Style="{StaticResource PageScroll}"><StackPanel>
    <TextBlock Text="{DynamicResource Desktop.CloudModels}" Style="{StaticResource PageTitle}"/>
    <TextBlock Text="{DynamicResource Desktop.Provider}" Style="{StaticResource Label}"/><ComboBox x:Name="CloudProvider" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="CloudProviderChanged" AutomationProperties.Name="{DynamicResource Desktop.Provider}" Margin="0,0,0,16"/>
    <Border Style="{StaticResource Card}" x:Name="QwenMtPanel"><StackPanel>
     <DockPanel Margin="0,0,0,8"><Button Content="{DynamicResource Desktop.SaveKey}" Click="SaveKeys" DockPanel.Dock="Right" MinHeight="28" Padding="10,5" FontSize="12"/><TextBlock Text="{DynamicResource Desktop.BailianKey}" Style="{StaticResource Section}"/></DockPanel><local:ApiKeyEditor x:Name="QwenKey"/>
     <TextBlock Text="{DynamicResource Desktop.BailianHint}" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
     <TextBlock Text="{DynamicResource Desktop.BailianUrl}" Style="{StaticResource Label}"/><TextBox x:Name="QwenUrl" TextChanged="PriceChanged" AutomationProperties.Name="{DynamicResource Desktop.BailianEndpoint}"/>
     <TextBlock Text="{DynamicResource Desktop.Asr}" Style="{StaticResource Label}"/>
     <DockPanel><Button Content="{DynamicResource Desktop.UseSpeech}" Click="ChooseDashScopeSpeech" DockPanel.Dock="Right" Margin="12,0,0,0"/><ComboBox x:Name="DashScopeSpeech" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="PriceChanged" AutomationProperties.Name="{DynamicResource Desktop.BailianSpeech}"/></DockPanel>
     <TextBlock x:Name="CloudAsrCost" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
     <TextBlock Text="{DynamicResource Desktop.UploadSpeech}" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
     <TextBlock Text="{DynamicResource Desktop.Nmt}" Style="{StaticResource Label}"/>
     <DockPanel><Button Content="{DynamicResource Desktop.UseTranslation}" Click="ChooseDashScopeTranslation" DockPanel.Dock="Right" Margin="12,0,0,0"/><ComboBox x:Name="DashScopeTranslation" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="PriceChanged" AutomationProperties.Name="{DynamicResource Desktop.BailianTranslation}"/></DockPanel>
     <TextBlock x:Name="CloudNmtCost" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}" x:Name="OpenAiPanel" Visibility="Collapsed"><StackPanel>
     <DockPanel Margin="0,0,0,8"><Button Content="{DynamicResource Desktop.SaveKey}" Click="SaveKeys" DockPanel.Dock="Right" MinHeight="28" Padding="10,5" FontSize="12"/><TextBlock Text="{DynamicResource Desktop.OpenAiKey}" Style="{StaticResource Section}"/></DockPanel><local:ApiKeyEditor x:Name="OpenAiKey"/>
     <TextBlock Text="{DynamicResource Desktop.Asr}" Style="{StaticResource Label}"/><DockPanel><Button Content="{DynamicResource Desktop.UseSpeech}" Click="ChooseOpenAiSpeech" DockPanel.Dock="Right" Margin="12,0,0,0"/><TextBlock Text="Whisper · whisper-1" VerticalAlignment="Center"/></DockPanel>
     <TextBlock x:Name="OpenAiAsrCost" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
     <TextBlock Text="{DynamicResource Desktop.Llm}" Style="{StaticResource Label}"/><DockPanel><Button Content="{DynamicResource Desktop.UseTranslation}" Click="ChooseOpenAiTranslation" DockPanel.Dock="Right" Margin="12,0,0,0"/><TextBlock Text="GPT-4.1 mini · gpt-4.1-mini" VerticalAlignment="Center"/></DockPanel>
     <TextBlock x:Name="OpenAiMtCost" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
    </StackPanel></Border>
    <Border Style="{StaticResource Card}" x:Name="ChatGptPanel" Visibility="Collapsed"><StackPanel>
     <TextBlock Text="{DynamicResource Desktop.UseChatGpt}" Style="{StaticResource Section}"/>
     <TextBlock Text="{DynamicResource Desktop.SubscriptionHint}" Style="{StaticResource Hint}" Margin="0,0,0,10"/>
     <Button Content="{DynamicResource Desktop.SignIn}" Click="ChatGptLogin" HorizontalAlignment="Left"/>
     <TextBlock Text="{DynamicResource Desktop.Account}" Style="{StaticResource Label}"/>
     <ComboBox x:Name="ChatGptAccount" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="ChatGptAccountChanged" AutomationProperties.Name="{DynamicResource Desktop.Account}"/>
     <TextBlock x:Name="ChatGptStatus" Style="{StaticResource Hint}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
     <WrapPanel Margin="0,8,0,0">
      <Button x:Name="ChatGptReauthorize" Content="{DynamicResource Desktop.Reauthorize}" Click="ChatGptLogin" Margin="0,0,8,6"/>
      <Button x:Name="ChatGptSignOut" Content="{DynamicResource Desktop.SignOut}" Click="ChatGptLogout" Margin="0,0,8,6"/>
      <Button Content="{DynamicResource Desktop.Usage}" Click="ChatGptUsage" Margin="0,0,0,6"/>
     </WrapPanel>
     <TextBlock Text="{DynamicResource Desktop.TranslationModel}" Style="{StaticResource Label}"/>
     <ComboBox x:Name="ChatGptModel" DisplayMemberPath="Label" SelectedValuePath="Value" SelectionChanged="SelectionChanged" AutomationProperties.Name="{DynamicResource Desktop.ChatGptModel}"/>
     <WrapPanel Margin="0,8,0,0">
