<UserControl x:Class="AheadSubs.ApiKeyEditor"

 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel Margin="0,0,0,8">
  <ComboBox x:Name="Mode" SelectedValuePath="Tag" SelectionChanged="ChangeMode" SelectedIndex="0" AutomationProperties.Name="{DynamicResource Desktop.KeySource}">
   <ComboBoxItem Tag="default" Content="{DynamicResource Desktop.KeyEnv}"/>
   <ComboBoxItem Tag="file" Content="{DynamicResource Desktop.KeyFile}"/>
   <ComboBoxItem Tag="direct" Content="{DynamicResource Desktop.KeyDirect}"/>
  </ComboBox>
  <DockPanel x:Name="FileRow" Visibility="Collapsed" Margin="0,8,0,0">
   <Button Content="{DynamicResource Desktop.ChooseFile}" Click="Browse" DockPanel.Dock="Right" Margin="12,0,0,0"/>
   <TextBox x:Name="KeyPath" AutomationProperties.Name="{DynamicResource Desktop.KeyPath}"/>
  </DockPanel>
  <StackPanel x:Name="DirectRow" Visibility="Collapsed" Margin="0,8,0,0">
   <PasswordBox x:Name="KeyInput" AutomationProperties.Name="API Key" Padding="8,5" MinHeight="34"/>
   <TextBlock x:Name="DirectHint" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
  </StackPanel>
 </StackPanel>
</UserControl>
