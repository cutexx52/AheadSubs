<UserControl x:Class="LocalVideoSubtitleTranslator.ApiKeyEditor"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel Margin="0,0,0,8">
  <ComboBox x:Name="Mode" SelectedValuePath="Tag" SelectionChanged="ChangeMode" SelectedIndex="0" AutomationProperties.Name="API Key 来源">
   <ComboBoxItem Tag="default">默认（环境变量）</ComboBoxItem>
   <ComboBoxItem Tag="file">密钥文件</ComboBoxItem>
   <ComboBoxItem Tag="direct">直接填写</ComboBoxItem>
  </ComboBox>
  <DockPanel x:Name="FileRow" Visibility="Collapsed" Margin="0,8,0,0">
   <Button Content="选择文件" Click="Browse" DockPanel.Dock="Right" Margin="12,0,0,0"/>
   <TextBox x:Name="KeyPath" AutomationProperties.Name="API Key 文件路径"/>
  </DockPanel>
  <StackPanel x:Name="DirectRow" Visibility="Collapsed" Margin="0,8,0,0">
   <PasswordBox x:Name="KeyInput" AutomationProperties.Name="API Key" Padding="8,5" MinHeight="34"/>
   <TextBlock x:Name="DirectHint" Style="{StaticResource Hint}" Margin="0,6,0,0"/>
  </StackPanel>
 </StackPanel>
</UserControl>
