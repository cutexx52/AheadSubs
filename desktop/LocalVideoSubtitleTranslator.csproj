<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LocalVideoSubtitleTranslator</AssemblyName>
    <RootNamespace>LocalVideoSubtitleTranslator</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\assets\aheadsubs.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="..\assets\aheadsubs.ico" Link="Assets\AheadSubs.ico" />
    <Resource Include="..\assets\aheadsubs.png" Link="Assets\AheadSubs.png" />
  </ItemGroup>
</Project>
